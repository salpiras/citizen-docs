root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Four spaces, per the official Kotlin coding conventions (see kotlin.code.style=official
# in gradle.properties).
indent_size = 4
indent_style = space
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composables are PascalCase and test names are backticked sentences; both trip these rules.
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled

[*.xml]
indent_size = 4
indent_style = space

[*.{json,yml,yaml,toml}]
indent_size = 2
indent_style = space
