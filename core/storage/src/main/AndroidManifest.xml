<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Declared here rather than in :app so the capability travels with the code that
          needs it. Manifest merging pulls it into the application.
          exported=false + grantUriPermissions: readers get access only via an Intent that
          carries FLAG_GRANT_READ_URI_PERMISSION, never ambiently.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
